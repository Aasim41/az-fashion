# JWT Configuration
JWT_SECRET=super_secret_jwt_key_here

# Nodemailer / Gmail Configuration
# For production, use your actual Gmail address and an App Password.
# If these are left blank, the system will use a mock Ethereal Email account automatically.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Admin Panel Credentials
ADMIN_EMAIL=admin@azshopify.com
ADMIN_PASSWORD=admin123

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_yourkeyhere
RAZORPAY_KEY_SECRET=your_razorpay_secret
